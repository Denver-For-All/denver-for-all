<script>
  // Topic cards reveal a static, Denver-specific answer panel. No external chat.
  document.addEventListener('DOMContentLoaded', () => {
    const topicCards = Array.from(document.querySelectorAll<HTMLElement>('.topic-card'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.answer-panel'));
    const closeButtons = Array.from(document.querySelectorAll<HTMLElement>('.answer-close'));

    function showPanel(key: string, trigger: HTMLElement) {
      let opened = false;
      panels.forEach((panel) => {
        const match = panel.getAttribute('data-answer') === key;
        // Toggle off if the active card is clicked again.
        const alreadyOpen = match && !panel.hidden;
        panel.hidden = !match || alreadyOpen;
        if (match && !alreadyOpen) opened = true;
      });

      topicCards.forEach((card) => {
        const isTrigger = card === trigger;
        card.classList.toggle('topic-card--active', isTrigger && opened);
        card.setAttribute('aria-expanded', String(isTrigger && opened));
      });

      if (opened) {
        const panel = document.querySelector<HTMLElement>(`.answer-panel[data-answer="${key}"]`);
        panel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    topicCards.forEach((card) => {
      card.addEventListener('click', () => {
        const key = card.getAttribute('data-topic-key');
        if (key) showPanel(key, card);
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const panel = btn.closest<HTMLElement>('.answer-panel');
        if (panel) panel.hidden = true;
        topicCards.forEach((card) => {
          card.classList.remove('topic-card--active');
          card.setAttribute('aria-expanded', 'false');
        });
      });
    });
  });
</script>

