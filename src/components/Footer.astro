---
import type { Locale } from '../i18n/utils';
import { siteConfig, siteName } from '@config/site';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const isEs = locale === 'es';
const prefix = isEs ? '/es' : '';
const year = new Date().getFullYear();
const name = siteName(locale);
const ghUrl = `https://github.com/${siteConfig.githubRepo}`;
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <h3 class="footer__logo">{name}</h3>
        <p class="footer__tagline">
          {siteConfig.tagline[locale] ?? siteConfig.tagline.en}
        </p>
      </div>

      <div class="footer__links">
        <h4 data-en="Platform" data-es="Plataforma">{isEs ? 'Plataforma' : 'Platform'}</h4>
        <a href={`${prefix}/platform`} data-en="All Proposals" data-es="Todas las Propuestas">{isEs ? 'Todas las Propuestas' : 'All Proposals'}</a>
        <a href={`${prefix}/run-for-denver`} data-en="Run For Denver" data-es="Postularse por Denver">{isEs ? 'Postularse por Denver' : 'Run For Denver'}</a>
        <a href={`${prefix}/take-action`} data-en="Take Action" data-es="Actúa">{isEs ? 'Actúa' : 'Take Action'}</a>
      </div>

      <div class="footer__links">
        <h4 data-en="Tools" data-es="Herramientas">{isEs ? 'Herramientas' : 'Tools'}</h4>
        <a href={`${prefix}/tools/ballot-2026`} data-en="November 2026 Ballot" data-es="Boleta de Noviembre de 2026">{isEs ? 'Boleta de Noviembre de 2026' : 'November 2026 Ballot'}</a>
        <a href={`${prefix}/tools/eviction-tracker`} data-en="Eviction Tracker" data-es="Rastreador de Desalojos">{isEs ? 'Rastreador de Desalojos' : 'Eviction Tracker'}</a>
        <a href={`${prefix}/tools/rent-calculator`} data-en="Rent Calculator" data-es="Calculadora de Alquiler">{isEs ? 'Calculadora de Alquiler' : 'Rent Calculator'}</a>
        <a href={`${prefix}/tools/campaign-finance`} data-en="Follow the Money" data-es="Sigue el Dinero">{isEs ? 'Sigue el Dinero' : 'Follow the Money'}</a>
        <a href={`${prefix}/tools/know-your-rights`} data-en="Know Your Rights" data-es="Conoce Tus Derechos">{isEs ? 'Conoce Tus Derechos' : 'Know Your Rights'}</a>
        <a href={`${prefix}/tools/sidewalk-data`} data-en="Sidewalk Data" data-es="Datos de Aceras">{isEs ? 'Datos de Aceras' : 'Sidewalk Data'}</a>
        <a href={`${prefix}/tools/eviction-data`} data-en="Eviction Data" data-es="Datos de Desalojos">{isEs ? 'Datos de Desalojos' : 'Eviction Data'}</a>
        <a href={`${prefix}/tools/money-in-politics`} data-en="Money in Politics" data-es="Dinero en Política">{isEs ? 'Dinero en Política' : 'Money in Politics'}</a>
      </div>

      <div class="footer__links">
        <h4 data-en="Connect" data-es="Conectar">{isEs ? 'Conectar' : 'Connect'}</h4>
        <a href={`mailto:${siteConfig.email}`} data-en="Email Us" data-es="Escríbenos">{isEs ? 'Escríbenos' : 'Email Us'}</a>
        {siteConfig.links.reddit && (
          <a href={siteConfig.links.reddit} target="_blank" rel="noopener">Reddit</a>
        )}
        {siteConfig.links.signal && (
          <a href={siteConfig.links.signal} target="_blank" rel="noopener" data-en="Signal Group" data-es="Grupo de Signal">{isEs ? 'Grupo de Signal' : 'Signal Group'}</a>
        )}
        {siteConfig.links.openCollective && (
          <a href={siteConfig.links.openCollective} target="_blank" rel="noopener" data-en="Donate · Public Ledger" data-es="Donar · Registro Público">{isEs ? 'Donar · Registro Público' : 'Donate · Public Ledger'}</a>
        )}
        <a href={ghUrl} target="_blank" rel="noopener" data-en="GitHub · Source Code" data-es="GitHub · Código Fuente">{isEs ? 'GitHub · Código Fuente' : 'GitHub · Source Code'}</a>
      </div>
    </div>

    <div class="footer__bottom">
      <p>
        <a href={ghUrl} target="_blank" rel="noopener" data-en="This site is open source." data-es="Este sitio es de código abierto.">{isEs ? 'Este sitio es de código abierto.' : 'This site is open source.'}</a>
        &copy; {year} {name}.
        <span data-en="Built with solidarity and open-source tools." data-es="Construido con solidaridad y herramientas de código abierto.">{isEs ? 'Construido con solidaridad y herramientas de código abierto.' : 'Built with solidarity and open-source tools.'}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    padding: 3rem 0 1.5rem;
    margin-top: 4rem;
  }

  .footer a {
    color: var(--color-footer-link);
  }

  .footer a:hover {
    color: white;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer__logo {
    font-size: 1.25rem;
    color: var(--color-footer-heading);
    margin-bottom: 0.5rem;
  }

  .footer__tagline {
    color: var(--color-footer-text);
    font-size: 0.9rem;
  }

  .footer__links h4 {
    color: var(--color-footer-heading);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .footer__links a {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--color-footer-text);
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
