---
import type { Locale } from '../i18n/utils';
import { LOCALES, DEFAULT_LOCALE, stripLocale, localizePath } from '../i18n/utils';
import { siteName } from '@config/site';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const isEs = locale === 'es';
const prefix = locale === DEFAULT_LOCALE ? '' : `/${locale}`;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/platform', en: 'Platform', es: 'Plataforma' },
  { href: '/run-for-denver', en: 'Run For Denver', es: 'Postularse' },
  { href: '/tools', en: 'Tools', es: 'Herramientas' },
  { href: '/take-action', en: 'Take Action', es: 'Actúa' },
  { href: '/about', en: 'About', es: 'Quiénes Somos' },
];

// Canonical (unprefixed) path, used to build the same page in each language.
const canonicalPath = stripLocale(currentPath);
const strippedPath = canonicalPath;
const langLinks = LOCALES.map((l) => ({
  ...l,
  href: localizePath(canonicalPath, l.code),
  active: l.code === locale,
}));
const current = langLinks.find((l) => l.active) ?? langLinks[0];
---

<header class="header">
  <div class="container header__inner">
    <a href={`${prefix}/`} class="header__logo">
      <span class="header__logo-icon">
        <img src="/favicon.svg" alt="" width="36" height="36" />
      </span>
      <span class="header__logo-text">{siteName(locale)}</span>
    </a>

    <nav class="header__nav" id="main-nav" aria-label={isEs ? 'Navegación principal' : 'Main navigation'}>
      {navItems.map(item => (
        <a
          href={`${prefix}${item.href}`}
          class:list={['header__link', { 'header__link--active': strippedPath.startsWith(item.href) }]}
          aria-current={strippedPath.startsWith(item.href) ? 'page' : undefined}
          data-en={item.en}
          data-es={item.es}
        >
          {isEs ? item.es : item.en}
        </a>
      ))}

      <details class="header__lang-switch" id="lang-switch">
        <summary class="header__lang-current" aria-label={isEs ? 'Cambiar idioma' : 'Change language'}>
          <span aria-hidden="true">🌐</span>
          <span class="header__lang-code">{current.short}</span>
        </summary>
        <ul class="header__lang-menu" role="menu">
          {langLinks.map((l) => (
            <li role="none">
              <a
                role="menuitem"
                href={l.href}
                lang={l.code}
                dir={l.dir}
                data-locale={l.code}
                class:list={['header__lang-option', { 'header__lang-option--active': l.active }]}
                aria-current={l.active ? 'true' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>

    <button class="header__menu-btn" id="menu-toggle" aria-label={isEs ? 'Abrir menú' : 'Toggle menu'} aria-expanded="false" aria-controls="main-nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .header__logo-text {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header__link {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all 0.2s;
  }

  .header__link:hover {
    color: var(--color-primary);
    background: var(--color-bg-alt);
  }

  .header__link--active {
    color: var(--color-primary);
    background: var(--color-bg-alt);
  }

  /* Language switcher (native <details> disclosure — works without JS) */
  .header__lang-switch {
    position: relative;
    margin-left: 0.5rem;
  }

  .header__lang-current {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.8rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .header__lang-current::-webkit-details-marker {
    display: none;
  }

  .header__lang-switch[open] .header__lang-current,
  .header__lang-current:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .header__lang-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    min-width: 160px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    z-index: 200;
  }

  html[dir='rtl'] .header__lang-menu {
    right: auto;
    left: 0;
  }

  .header__lang-option {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
  }

  .header__lang-option:hover {
    background: var(--color-bg-alt);
    color: var(--color-primary);
  }

  .header__lang-option--active {
    color: var(--color-primary);
    font-weight: 700;
  }

  .header__menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .header__menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    transition: all 0.2s;
  }

  @media (max-width: 768px) {
    .header__nav {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--color-bg-card);
      flex-direction: column;
      padding: 1rem;
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
    }

    .header__nav.open {
      display: flex;
    }

    .header__link {
      width: 100%;
      padding: 0.75rem 1rem;
    }

    .header__lang-switch {
      width: 100%;
      margin-left: 0;
    }

    .header__lang-menu {
      position: static;
      box-shadow: none;
      border: none;
      padding: 0;
      min-width: 0;
    }

    .header__menu-btn {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
    const expanded = nav?.classList.contains('open') ?? false;
    toggle?.setAttribute('aria-expanded', String(expanded));
  });

  // Remember the chosen language so default-locale visits can auto-redirect.
  const langSwitch = document.getElementById('lang-switch');
  langSwitch?.querySelectorAll('a[data-locale]').forEach((link) => {
    link.addEventListener('click', () => {
      const code = link.getAttribute('data-locale');
      if (code) localStorage.setItem('dfa-locale', code);
    });
  });

  // Close the language menu when clicking outside it.
  document.addEventListener('click', (e) => {
    const details = langSwitch as HTMLDetailsElement | null;
    if (details?.open && !details.contains(e.target as Node)) {
      details.open = false;
    }
  });
</script>
